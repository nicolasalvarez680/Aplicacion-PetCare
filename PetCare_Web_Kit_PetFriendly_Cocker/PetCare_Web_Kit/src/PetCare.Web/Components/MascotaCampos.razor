@using Microsoft.AspNetCore.Components
<div class="form-group">
    <label for="tipoMascota">Tipo de mascota</label>
    <select id="tipoMascota" name="tipoMascota" class="form-control" required data-tipo-mascota="true">
        <option value="" selected="@(string.IsNullOrEmpty(Tipo))">Selecciona el tipo</option>
        <option value="Perro" selected="@(Tipo == "Perro")">Perro</option>
        <option value="Gato" selected="@(Tipo == "Gato")">Gato</option>
    </select>
</div>
<div class="form-group" data-raza-grupo="true">
    <label for="razaMascota">Raza del perro</label>
    <input id="razaMascota" name="razaMascota" class="form-control" type="text" maxlength="80" value="@Raza" list="razasPerro" placeholder="Ej. Cocker Spaniel, Labrador, Mestizo" data-raza-mascota="true" />
    <datalist id="razasPerro">
        @foreach (var raza in Razas)
        {
            <option value="@raza"></option>
        }
    </datalist>
    <small class="form-help">Obligatoria para perros. Puedes escribir otra raza, Mestizo o No identificada.</small>
</div>
@code {
    [Parameter] public string? Tipo { get; set; }
    [Parameter] public string? Raza { get; set; }
    private static readonly string[] Razas = new[] { "Beagle", "Border Collie", "Bulldog francés", "Caniche", "Chihuahua", "Cocker Spaniel", "Golden Retriever", "Labrador Retriever", "Mestizo", "No identificada", "Pastor alemán", "Pomerania", "Schnauzer", "Shih Tzu", "Yorkshire Terrier" };
}

@page "/hospitalizaciones"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PetCare.Domain.Entities
@using PetCare.Infrastructure.Services
@attribute [Authorize(Policy = "PersonalAutorizado")]
@inject AuthenticationStateProvider Auth
@inject HospitalizacionService Servicio
<PageTitle>Hospitalizaciones | PetCare</PageTitle>
<div class="admin-page">
<div class="page-header">
<div>
<span class="eyebrow">PETCARE WEB · GESTIÓN VETERINARIA</span>
<h1>Hospitalizaciones</h1>
<p class="page-description">Gestiona ingresos, estancias y altas.</p>
</div>
<a class="btn btn-primary" href="/hospitalizaciones/nueva">+ Nuevo ingreso</a>
</div>
<OperacionAvisos Error="@(cargaError ?? Error)" Ok="@Ok" />
<div class="stats-grid">
<article class="stat-card">
<div class="stat-icon mint">📋</div>
<div class="stat-value">@datos.Count</div>
<div class="stat-label">Total de ingresos</div>
</article>
<article class="stat-card">
<div class="stat-icon blue">🏥</div>
<div class="stat-value">@(datos.Count(x => x.EstaHospitalizado))</div>
<div class="stat-label">Hospitalizados</div>
</article>
<article class="stat-card">
<div class="stat-icon lilac">✓</div>
<div class="stat-value">@(datos.Count(x => !x.EstaHospitalizado))</div>
<div class="stat-label">Dados de alta</div>
</article>
</div>
<div class="content-card">
<h2>Listado de hospitalizaciones</h2>
<form method="get" action="/hospitalizaciones" data-enhance="false" class="hospital-toolbar">
<input type="search" name="q" class="form-control" aria-label="Buscar" placeholder="Buscar código, mascota, tipo o raza" value="@Q"/>
<select name="estado" class="form-control" aria-label="Estado">
<option value="" selected="@(string.IsNullOrEmpty(Estado))">Todos los estados</option>
<option value="activos" selected="@(Estado == "activos")">Hospitalizados</option>
<option value="altas" selected="@(Estado == "altas")">Dados de alta</option>

</select>
<button class="btn btn-secondary" type="submit">Buscar</button>
</form>
<div class="table-container">
<table class="table">
<thead>
<tr>
<th>Código</th>
<th>Mascota</th>
<th>Ingreso</th>
<th>Alta</th>
<th>Días</th>
<th>Tarifa diaria</th>
<th>Costo total</th>
<th>Estado</th>
<th>Acciones</th>
</tr>
</thead>
<tbody>
@foreach (var x in Filtrados) {
<tr>
<td>@x.Codigo</td>
<td>
<strong>@x.NombreMascota</strong>
<small class="pet-animal-detail">@(x.TipoMascota ?? "Sin registrar")@(x.TipoMascota == "Perro" ? " · " + x.RazaMascota : "")</small>
</td>
<td>@x.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
<td>@(x.FechaAlta?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
<td>@x.CalcularDias()</td>
<td>@Moneda(x.TarifaDiaria)</td>
<td>
<strong>@Moneda(x.ObtenerPrecioUnitario())</strong>
</td>
<td>
<span class="hospital-status @(x.EstaHospitalizado ? "active" : "discharged")">@(x.EstaHospitalizado ? "Hospitalizado" : "Dado de alta")</span>
</td>
<td>
<a class="btn btn-secondary" href="@($"/hospitalizaciones/editar/{x.Id}")">Gestionar / ver</a>
</td>
</tr>
}
</tbody>
</table>
</div>
@if (!Filtrados.Any()) { <p class="empty-state">No se encontraron hospitalizaciones.</p>
}
</div>
</div>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
    private string? cargaError;
    private static string Moneda(decimal valor) => valor.ToString("C2", CultureInfo.GetCultureInfo("es-CO"));
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }
    private bool Coincide(string texto) => string.IsNullOrWhiteSpace(Q) || texto.Contains(Q.Trim(), StringComparison.OrdinalIgnoreCase);
    private List<Hospitalizacion> datos = new();
    private IEnumerable<Hospitalizacion> Filtrados => datos.Where(x => Coincide(x.Codigo + " " + x.NombreMascota + " " + x.TipoMascota + " " + x.RazaMascota) && (Estado != "activos" || x.EstaHospitalizado) && (Estado != "altas" || !x.EstaHospitalizado));
    protected override async Task OnParametersSetAsync()
    {
        cargaError = null;
        try { datos = await Servicio.ObtenerTodasAsync((await Auth.GetAuthenticationStateAsync()).User); }
        catch (Exception) { datos.Clear(); cargaError = "No se pudieron consultar los registros. Comprueba la conexión y tu sesión."; }
    }
}

@page "/farmacia/nuevo"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PetCare.Domain.Entities
@using PetCare.Infrastructure.Services
@attribute [Authorize(Policy = "PersonalAutorizado")]
@inject AuthenticationStateProvider Auth
<PageTitle>Nuevo lote | PetCare</PageTitle>
<div class="admin-page form-page">
<div class="breadcrumb">
<a href="/dashboard">Inicio</a> / <a href="/farmacia">Farmacia</a>
</div>
<div class="page-header">
<div>
<span class="eyebrow">PETCARE WEB · GESTIÓN VETERINARIA</span>
<h1>Registrar lote</h1>
<p class="page-description">Agrega un medicamento al inventario.</p>
</div>
</div>
<OperacionAvisos Error="@Error" Ok="@Ok" />
<div class="content-card">
<form method="post" action="/operaciones/farmacia/nuevo" data-enhance="false" >
    <AntiforgeryToken />
<div class="hospital-form-grid">
<div class="form-group">
<label for="codigo">Código de lote</label>
<input class="form-control" id="codigo" name="codigo" type="text" required maxlength="20" />
</div>
<div class="form-group">
<label for="nombre">Nombre del medicamento</label>
<input class="form-control" id="nombre" name="nombre" type="text" required maxlength="100" />
</div>
<div class="form-group">
<label for="vencimiento">Fecha de vencimiento</label>
<input class="form-control" id="vencimiento" name="vencimiento" type="date" required />
</div>
<div class="form-group">
<label for="precio">Precio unitario (COP)</label>
<input class="form-control" id="precio" name="precio" type="number" required min="0.01" step="0.01" max="9999999999999999.99" />
</div>
<div class="form-group">
<label for="existencias">Existencias iniciales</label>
<input class="form-control" id="existencias" name="existencias" type="number" value="0" required min="0" max="1000000" step="1" />
</div>
</div>
    <div class="form-actions">
<button type="submit" class="btn btn-primary">Registrar lote</button>
</div>
</form>
<a class="btn btn-secondary" href="/farmacia">Cancelar</a>
</div>
</div>
@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? Ok { get; set; }
}
